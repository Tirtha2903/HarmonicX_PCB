# OpenAI API configuration
# Create an API key in the OpenAI platform. Keep the real key in your local .env only.
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=your_openai_api_key_here
AI_MODEL=gpt-4o-mini

# Optional: absolute path to kicad-cli. Leave blank if it is on PATH.
KICAD_CLI_PATH=

# Application limits
MAX_IMAGE_MB=8
MAX_PROMPT_CHARS=12000
OUTPUT_DIR=projects
LOG_LEVEL=INFO

# Circuit DNA SQLite database (relative paths resolve from the repository root)
DNA_DB_PATH=circuitpilot_dna.db

# Optional AI-assisted stages. Deterministic checks and the Virtual Lab
# baseline still run when these are disabled or the provider is unavailable.
ENABLE_AI_RED_TEAM=true
ENABLE_AI_VIRTUAL_LAB=true
