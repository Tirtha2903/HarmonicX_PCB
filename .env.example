# Google Gemini API configuration (via Google AI Studio OpenAI-compatible endpoint)
AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
AI_API_KEY=your_gemini_api_key_here
AI_MODEL=gemini-3-flash-preview

# Optional: absolute path to kicad-cli. Leave blank if it is on PATH.
KICAD_CLI_PATH=

# Application limits
MAX_IMAGE_MB=8
MAX_PROMPT_CHARS=12000
OUTPUT_DIR=projects
LOG_LEVEL=INFO
