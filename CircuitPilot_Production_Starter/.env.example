# OpenAI-compatible Chat Completions endpoint.
# Use the exact base URL documented by your provider (often ends in /v1).
AI_BASE_URL=https://YOUR_PROVIDER_BASE_URL/v1
AI_API_KEY=replace_with_your_secret
AI_MODEL=replace_with_exact_model_id

# Optional: absolute path to kicad-cli. Leave blank if it is on PATH.
KICAD_CLI_PATH=

# Application limits
MAX_IMAGE_MB=8
MAX_PROMPT_CHARS=12000
OUTPUT_DIR=projects
LOG_LEVEL=INFO
